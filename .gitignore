# Python cache
__pycache__/
*.py[cod]

# macOS
.DS_Store

# Local environment
.env
.env.*
!.env.example

# Agent sandboxes
sandboxes/

# Runtime sessions
runs/*
!runs/.gitkeep
data/*.db
data/*.sqlite
data/*.sqlite3
data/*.json
data/*.jsonl

# Archived tasks keep only placeholders by default
tasks/done/*
!tasks/done/.gitkeep
tasks/blocked/*
!tasks/blocked/.gitkeep
tasks/needs-human/*
!tasks/needs-human/.gitkeep
